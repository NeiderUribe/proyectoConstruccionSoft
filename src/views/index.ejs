<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Righteous&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <h1>🍔 Tierra Querida</h1>
                </div>
                <nav class="nav">
                    <a href="/" class="nav-link active">Inicio</a>
                    <a href="/login" class="nav-link btn-primary">Iniciar Sesión</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-background">
            <div class="hero-pattern"></div>
        </div>
        <div class="hero-content">
            <div class="hero-badge">🏍️🍔♥️</div>
            <h2 class="hero-title">Domicilios gratis por compras superiores a $100.000</h2>
            <p class="hero-subtitle">Únicamente en nuestro sitio Web</p>
            <div class="hero-buttons">
                <a href="/register" class="btn btn-large btn-glow">PIDE AQUÍ</a>
                <a href="/menu" class="btn btn-large btn-white">Ver Menú</a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">¿Quiénes Somos?</h2>
                <div class="title-underline"></div>
            </div>
            <div class="about-content">
                <div class="about-card">
                    <div class="about-icon">🍔</div>
                    <p class="about-text">
                        Hace 5 años, comenzaba en una cocina oculta… el sueño de servir algo más que comida.
                    </p>
                </div>
                <div class="about-card">
                    <div class="about-icon">🔥</div>
                    <p class="about-text">
                        Sin letreros, sin mesas, sin filas. Solo una plancha caliente y 4 emprendedores con ganas de conquistar el corazón de los colombianos.
                    </p>
                </div>
                <div class="about-card">
                    <div class="about-icon">🚀</div>
                    <p class="about-text">
                        Desde un rincón escondido, empezamos a llegar a casas, a oficinas, a reuniones. No nos conocían por el nombre… pero sí por el sabor.
                    </p>
                </div>
                <div class="about-highlight">
                    <p class="highlight-text">
                        Hoy somos 100 sedes a nivel nacional y la misión no para.
                    </p>
                    <p class="hashtag">#MovimientoTQ</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features">
        <div class="container">
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <div class="feature-icon">🍔</div>
                    </div>
                    <h3>Comida Deliciosa</h3>
                    <p>Sabores únicos que conquistan corazones</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <div class="feature-icon">🏍️</div>
                    </div>
                    <h3>Domicilios Rápidos</h3>
                    <p>Llegamos a tu casa en tiempo récord</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <div class="feature-icon">📍</div>
                    </div>
                    <h3>100 Sedes</h3>
                    <p>En todo el territorio nacional</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-content">
                <h2>¿Listo para pedir?</h2>
                <p>Regístrate ahora y disfruta de nuestros deliciosos productos</p>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="/register" class="btn btn-large btn-white">Registrarse</a>
                    <a href="/menu" class="btn btn-large btn-outline" style="color: white; border-color: white;">Ver Menú</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4>Conócenos</h4>
                    <ul>
                        <li><a href="#">Trabaja con nosotros</a></li>
                        <li><a href="#">Efecto TQ</a></li>
                        <li><a href="#">Términos y condiciones</a></li>
                        <li><a href="#">Política de privacidad</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Redes sociales</h4>
                    <ul>
                        <li><a href="#">Instagram</a></li>
                        <li><a href="#">Facebook</a></li>
                        <li><a href="#">TikTok</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Mi cuenta</h4>
                    <ul>
                        <li><a href="/register">Pedir</a></li>
                        <li><a href="/login">Iniciar sesión</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Tierra Querida. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>
</body>
</html>
