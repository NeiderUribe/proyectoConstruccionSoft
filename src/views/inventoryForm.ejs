<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header class="header admin-header">
        <div class="container">
            <div class="header-content">
                <div class="logo"><h1>🍔 Panel Administrador</h1></div>
                <nav class="nav">
                    <a href="/admin" class="nav-link">← Dashboard</a>
                    <a href="/admin/inventory" class="nav-link">Inventario</a>
                    <a href="/logout" class="nav-link btn-danger">Cerrar Sesión</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="main-content admin-main">
        <div class="container">
            <div class="form-page">
                <div class="page-header">
                    <h1><%= item ? 'Editar Item de Inventario' : 'Crear Item de Inventario' %></h1>
                    <a href="/admin/inventory" class="btn btn-outline">← Volver</a>
                </div>

                <% if (error) { %>
                    <div class="alert alert-error"><strong>Error:</strong> <%= error %></div>
                <% } %>

                <form action="<%= action %>" method="POST" class="form-card">
                    <div class="form-group">
                        <label for="name">Nombre *</label>
                        <input type="text" id="name" name="name" value="<%= item ? item.name : '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="description">Descripción *</label>
                        <input type="text" id="description" name="description" value="<%= item ? item.description : '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="category_id">Categoría *</label>
                        <select id="category_id" name="category_id" required>
                            <option value="">Seleccione una categoría</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id_category %>" <%= item && item.id_category == cat.id_category ? 'selected' : '' %>>
                                    <%= cat.name %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="amount">Cantidad *</label>
                        <input type="number" id="amount" name="amount" value="<%= item ? item.amount : '' %>" min="0" required>
                    </div>

                    <div class="form-group">
                        <label for="price">Precio *</label>
                        <input type="number" id="price" name="price" step="0.01" value="<%= item ? item.price : '' %>" min="0" required>
                    </div>

                    <div class="form-group">
                        <label for="unit_measurement">Unidad de Medida *</label>
                        <input type="text" id="unit_measurement" name="unit_measurement" value="<%= item ? item.unit_measurement : '' %>" placeholder="kg, litros, unidades, etc." required>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary"><%= item ? 'Actualizar' : 'Crear' %> Item</button>
                        <a href="/admin/inventory" class="btn btn-outline">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>

