<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="logo"><h1>🍔 Tierra Querida</h1></div>
                <nav class="nav">
                    <a href="/menu" class="nav-link">Menú</a>
                    <a href="/logout" class="nav-link">Cerrar Sesión</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="main-content">
        <div class="container">
            <div class="form-page">
                <div class="page-header">
                    <h1>Procesar Pago</h1>
                </div>

                <div class="form-card">
                    <div style="text-align: center; margin-bottom: 2rem;">
                        <h2>Resumen del Pedido</h2>
                        <p style="font-size: 1.2rem; color: var(--text-light);">Pedido #<%= order.id_order %></p>
                        <p style="font-size: 2rem; font-weight: 700; color: var(--primary-color); margin-top: 1rem;">
                            Total: $<%= parseFloat(order.total).toFixed(2) %>
                        </p>
                    </div>

                    <form action="/payment" method="POST">
                        <input type="hidden" name="order_id" value="<%= order.id_order %>">
                        
                        <div class="form-group">
                            <label>Método de Pago</label>
                            <select name="payment_method" required style="width: 100%; padding: 1rem; border: 2px solid var(--border-color); border-radius: 10px;">
                                <option value="pix">PIX</option>
                                <option value="credit_card">Tarjeta de Crédito</option>
                                <option value="debit_card">Tarjeta de Débito</option>
                            </select>
                        </div>

                        <div style="background: var(--light-color); padding: 1.5rem; border-radius: 10px; margin: 1.5rem 0;">
                            <p style="color: var(--text-light); font-size: 0.9rem; margin-bottom: 0.5rem;">
                                💳 Integración con Mercado Pago
                            </p>
                            <p style="color: var(--text-dark); font-size: 0.85rem;">
                                Al confirmar, serás redirigido a Mercado Pago para completar el pago de forma segura.
                            </p>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary btn-block btn-large">Pagar con Mercado Pago</button>
                            <a href="/menu" class="btn btn-outline btn-block">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</body>
</html>

